# Copy to .env and replace placeholders with local paths/confirmed values.

# Prompt/post-training data. This directory contains the GIFT-Eval dataset folders.
GIFT_EVAL=/path/to/gift-eval/data

# TIME benchmark checkout (must contain src/timebench).
TIME_REPO=/path/to/TIME

# Tabby-Pretrain inputs used by recipes/pretrain/train_165k.sh.
BLAST_DATA_ROOT=/path/to/BLAST/train
SYNTHETIC_ARROW_ROOT=/path/to/kernel_synth_arrow

# Fill these with the confirmed no-GIFT 165K mixture. KernelSynth receives the
# remainder: 1 - BLAST_RATIO - CAUKER_V2_RATIO.
BLAST_RATIO=
CAUKER_V2_RATIO=
